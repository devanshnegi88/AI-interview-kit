# Copy this file to .env and fill in real values. Never commit .env.

# HTTP
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (the frontend URL in dev)
CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_prep_kit

# Auth (Phase 3). Generate a long random string for SESSION_SECRET.
SESSION_SECRET=change_me_to_a_long_random_string
SESSION_COOKIE_NAME=sid
SESSION_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

# Secure HTTP client (Phase 4)
HTTP_TIMEOUT_MS=10000
HTTP_MAX_BYTES=2097152
HTTP_MAX_REDIRECTS=5
HTTP_MIN_INTERVAL_MS=250

# LLM (Phase 6). Default provider is Groq (genuine free tier).
# Get a key: https://console.groq.com
# Optional: LLM_PROVIDER=xai with XAI_API_KEY, or ollama (local, no key).
LLM_PROVIDER=groq
LLM_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
LLM_MAX_CONCURRENCY=1
LLM_MIN_INTERVAL_MS=1500
LLM_MAX_RETRIES=3
LLM_MAX_REPAIR_ATTEMPTS=2
