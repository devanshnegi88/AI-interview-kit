# Copy this file to .env and fill in real values. Never commit .env.

# HTTP
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (the frontend URL in dev)
CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_prep_kit

# Auth (Phase 3). Generate a long random string for SESSION_SECRET.
SESSION_SECRET=change_me_to_a_long_random_string
SESSION_COOKIE_NAME=sid
SESSION_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

# Secure HTTP client (Phase 4)
HTTP_TIMEOUT_MS=10000
HTTP_MAX_BYTES=2097152
HTTP_MAX_REDIRECTS=5
HTTP_MIN_INTERVAL_MS=250

# Reserved for later phases
LLM_PROVIDER=
LLM_API_KEY=
